// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// P05 · Users and profiles (D5: 3 dummy users, no auth)
// Profile fields come from the IDEATION onboarding list. Every field is nullable
// until onboarding (P09) fills it in.
// ---------------------------------------------------------------------------

enum Goal {
  lose_fat
  build_muscle
  maintain
  get_fitter
}

enum Sex {
  male
  female
  unspecified
}

enum ActivityLevel {
  sedentary
  light
  moderate
  active
  very_active
}

enum Diet {
  veg
  eggetarian
  jain
  non_veg
}

enum Pace {
  gentle
  steady
  ambitious
}

enum Coach {
  drill_sergeant
  calm_mentor
  desi_legend
}

model User {
  id          String   @id @db.Uuid
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile    Profile?
  syncProbes SyncProbe[]
  mealLogs   MealLog[]
  foods      Food[]
  exercises  Exercise[]
  workouts   Workout[]
  routines   Routine[]
  activities Activity[]
  weightLogs WeightLog[]
  waterLogs  WaterLog[]
  checkins   Checkin[]
  phases     Phase[]
  dayBriefs  DayBrief[]
  dayPlans   DayPlan[]
  memoryFacts MemoryFact[]

  @@map("users")
}

model Profile {
  userId           String         @id @map("user_id") @db.Uuid
  goal             Goal?
  age              Int?
  sex              Sex?
  heightCm         Float?         @map("height_cm")
  weightKg         Float?         @map("weight_kg")
  activityLevel    ActivityLevel? @map("activity_level")
  diet             Diet?
  targetWeightKg   Float?         @map("target_weight_kg")
  pace             Pace?
  coach            Coach?
  /// P18: ask how much oil/ghee went into home-cooked food on the confirm sheet (D34).
  oilGheePrompt    Boolean        @default(false) @map("oil_ghee_prompt")
  /// Daily step goal (D48): 8,000 default and minimum, 100,000 maximum.
  stepGoal         Int            @default(8000) @map("step_goal")
  /// Daily water goal in glasses, 1–20, set on the onboarding target step.
  waterGoalGlasses Int            @default(8) @map("water_goal_glasses")
  /// P28: the weekly check-in shows the detailed (geek) version instead of the simple one (D50).
  checkinDetailed  Boolean        @default(false) @map("checkin_detailed")
  /// LA1 · Standing life (docs/LIFE_PLAN.md). Every answer can be skipped (null).
  mealSource        LifeMealSource? @map("meal_source")
  budget            BudgetBand?     @map("budget")
  workPattern       WorkPattern?    @map("work_pattern")
  hasKitchen        Boolean?        @map("has_kitchen")
  hasFridge         Boolean?        @map("has_fridge")
  /// 0–7; null = learn from logs.
  sessionsPerWeek   Int?            @map("sessions_per_week")
  /// Minute of the day for the evening brief prompt (D73); null = off.
  briefPromptMinute Int?            @map("brief_prompt_minute")
  onboardedAt      DateTime?      @map("onboarded_at") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// P07 · Sync probe — dev-only entity that exercises the offline outbox end to end.
// Real local-first entities (meals, workouts, activities, weights) arrive in later phases
// and use the same sync endpoint.
// ---------------------------------------------------------------------------

model SyncProbe {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  note            String
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sync_probes")
}

// ---------------------------------------------------------------------------
// P11 · Food database (D29). Values are per 100 g (per 100 ml for liquids). Curated foods are
// seeded from prisma/data/foods.ts and keyed by `slug` so the seed can upsert them.
// ---------------------------------------------------------------------------

enum Cuisine {
  indian
  indo_chinese
  italian
  continental
  other
}

/// Drives the category icon tile (D15, brand §10).
enum FoodCategory {
  home_meal
  restaurant
  bread
  rice
  protein
  dairy
  drink
  snack
  sweet
  fruit
  vegetable
}

enum FoodUnitKind {
  g
  ml
  piece
  katori
  bowl
  plate_half
  plate_full
  glass
  cup
  tbsp
  tsp
  slice
  serving
}

model Food {
  id              String       @id @db.Uuid
  slug            String       @unique
  name            String
  aliases         String[]     @default([])
  cuisine         Cuisine
  category        FoodCategory
  diet            Diet
  /// Gets the oil/ghee question when the P18 setting is on.
  homeCooked      Boolean      @default(false) @map("home_cooked")
  liquid          Boolean      @default(false)
  kcalPer100g     Float        @map("kcal_per_100g")
  proteinPer100g  Float        @map("protein_per_100g")
  carbsPer100g    Float        @map("carbs_per_100g")
  fatPer100g      Float        @map("fat_per_100g")
  defaultUnit     FoodUnitKind @map("default_unit")
  /// Where the numbers come from, e.g. "kimbo-curated-v1", or "user" for a created food.
  source          String
  /// P13: set for a user-created food (visible only to that user); null for the shared catalog.
  ownerUserId     String?      @map("owner_user_id") @db.Uuid
  /// P13: user-created foods sync from the phone (last-write-wins, D23).
  clientUpdatedAt DateTime?    @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner     User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  units     FoodUnitOption[]
  mealItems MealItem[]

  @@index([ownerUserId])
  @@map("foods")
}

/// One way to measure a food: 1 `unit` = `grams` g (or ml).
model FoodUnitOption {
  foodId String       @map("food_id") @db.Uuid
  unit   FoodUnitKind
  grams  Float
  /// Optional display label, e.g. "1 roti (40 g)".
  label  String?

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@id([foodId, unit])
  @@map("food_units")
}

// ---------------------------------------------------------------------------
// P12 · Meal logs (local-first, D23). Written on the phone first and pushed through
// POST /v1/users/:id/sync (entity "meal_log"). Items keep a snapshot of their macros so editing a
// food later never rewrites history.
// ---------------------------------------------------------------------------

enum MealType {
  breakfast
  lunch
  snack
  dinner
}

enum MealSource {
  search
  text
  voice
  photo
  repeat
}

enum OilLevel {
  little
  normal
  heavy
}

model MealLog {
  id              String     @id @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  mealType        MealType   @map("meal_type")
  loggedAt        DateTime   @map("logged_at") @db.Timestamptz(3)
  /// The user's local calendar day (YYYY-MM-DD), so "today" doesn't depend on the server's time zone.
  localDate       String     @map("local_date")
  source          MealSource
  /// P18: the oil/ghee answer for home-cooked items, if asked.
  oilLevel        OilLevel?  @map("oil_level")
  clientUpdatedAt DateTime   @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  @@index([userId, localDate])
  @@map("meal_logs")
}

model MealItem {
  id        String       @id @db.Uuid
  mealLogId String       @map("meal_log_id") @db.Uuid
  /// null when the food was deleted or never matched.
  foodId    String?      @map("food_id") @db.Uuid
  position  Int
  name      String
  quantity  Float
  unit      FoodUnitKind
  grams     Float
  kcal      Float
  proteinG  Float        @map("protein_g")
  carbsG    Float        @map("carbs_g")
  fatG      Float        @map("fat_g")

  mealLog MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  food    Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([mealLogId])
  @@map("meal_items")
}

// ---------------------------------------------------------------------------
// P19 · Exercises and workouts (D38). Curated exercises are seeded from prisma/data/exercises.ts and keyed
// by `slug`; user-created exercises (owner_user_id set) sync from the phone as "custom_exercise".
// Workouts are local-first (D23): logged on the phone, pushed as "workout" once finished. Exercises and
// sets keep a snapshot of the exercise name and type, so editing an exercise never rewrites history.
// ---------------------------------------------------------------------------

enum ExerciseCategory {
  chest
  back
  shoulders
  biceps
  triceps
  legs
  abs
  cardio
}

enum ExerciseType {
  weight_reps
  reps
  time
  distance_time
}

model Exercise {
  id              String           @id @db.Uuid
  slug            String           @unique
  name            String
  aliases         String[]         @default([])
  category        ExerciseCategory
  type            ExerciseType
  /// How-to page on musclewiki.com. Curated: from the seed. User-created: optional, typed by the user.
  referenceUrl    String?          @map("reference_url")
  /// "kimbo-curated-v1" for the seed, "user" for a created exercise.
  source          String
  ownerUserId     String?          @map("owner_user_id") @db.Uuid
  clientUpdatedAt DateTime?        @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner            User?             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]
  routineExercises RoutineExercise[]

  @@index([ownerUserId])
  @@map("exercises")
}

model Workout {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String
  startedAt       DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime  @map("ended_at") @db.Timestamptz(3)
  /// The user's local calendar day (YYYY-MM-DD) the workout started on.
  localDate       String    @map("local_date")
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// P21: the routine this workout was started from, if any.
  routineId       String?   @map("routine_id") @db.Uuid

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutExercise[]
  routine   Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)

  @@index([userId, localDate])
  @@map("workouts")
}

model WorkoutExercise {
  id         String       @id @db.Uuid
  workoutId  String       @map("workout_id") @db.Uuid
  /// null when the exercise was deleted or never reached the server.
  exerciseId String?      @map("exercise_id") @db.Uuid
  position   Int
  name       String
  type       ExerciseType

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets     WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                String    @id @db.Uuid
  workoutExerciseId String    @map("workout_exercise_id") @db.Uuid
  position          Int
  weightKg          Float?    @map("weight_kg")
  reps              Int?
  durationS         Int?      @map("duration_s")
  distanceM         Float?    @map("distance_m")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  /// P20: records this set broke when it was logged (D39), e.g. {weight,e1rm}. Empty = not a PR.
  prKinds           String[]  @default([]) @map("pr_kinds")

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
  @@map("workout_sets")
}

// ---------------------------------------------------------------------------
// P21 · Routines (S26). A saved list of exercises with target sets × reps, started as a workout from S22.
// Local-first, synced as "routine" (D23). Exercises keep a name snapshot like workouts do.
// ---------------------------------------------------------------------------

model Routine {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  workouts  Workout[]

  @@index([userId])
  @@map("routines")
}

model RoutineExercise {
  id         String       @id @db.Uuid
  routineId  String       @map("routine_id") @db.Uuid
  exerciseId String?      @map("exercise_id") @db.Uuid
  position   Int
  name       String
  type       ExerciseType
  targetSets Int          @map("target_sets")
  /// null for exercises without reps (holds, cardio).
  targetReps Int?         @map("target_reps")

  routine  Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([routineId])
  @@map("routine_exercises")
}

// ---------------------------------------------------------------------------
// GPS activities (P24–P26). Recorded on the phone, synced as "activity" once finished (D23). The route is
// kept as one JSON array of [latitude, longitude, timestamp ms, accuracy m, segment, active ms] tuples.
// ---------------------------------------------------------------------------

enum ActivityKind {
  run
  walk
  ride
}

model Activity {
  id              String       @id @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  kind            ActivityKind
  weightKg        Float        @map("weight_kg")
  startedAt       DateTime     @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime     @map("ended_at") @db.Timestamptz(3)
  /// The local day the activity finished on (credit goes to the completion day).
  localDate       String       @map("local_date")
  elapsedMs       Int          @map("elapsed_ms")
  points          Json         @default("[]")
  clientUpdatedAt DateTime     @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// P27 · Weigh-ins. Local-first (D23), synced as entity "weight_log". Several on one day are averaged for the
// trend (D49).

model WeightLog {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// The local day the weigh-in is for (the user can pick an earlier day on S34).
  localDate       String    @map("local_date")
  kg              Float
  loggedAt        DateTime  @map("logged_at") @db.Timestamptz(3)
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, localDate])
  @@map("weight_logs")
}

/// Water taps from Today: each log is one or more glasses on a local day. Synced as "water_log".
model WaterLog {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  /// The local day the water counts for (a past day can be picked on Today).
  localDate       String    @map("local_date")
  glasses         Int
  loggedAt        DateTime  @map("logged_at") @db.Timestamptz(3)
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, localDate])
  @@map("water_logs")
}

// ---------------------------------------------------------------------------
// P28 · Weekly check-ins = the target history (D26, D50). One row per user per check-in Sunday, written by the
// phone when the user answers it (computed lazily on the device). "accepted" rows set the target from
// checkin_date on; "kept" and "skipped" (not enough data) rows record the week without changing it.

enum CheckinStatus {
  accepted
  kept
  skipped
}

model Checkin {
  id                String        @id @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  /// The phase active at the check-in (P29). Not a foreign key: phases sync on their own.
  phaseId           String?       @map("phase_id") @db.Uuid
  /// The Sunday this check-in belongs to; the week covered is the 7 days before it.
  checkinDate       String        @map("checkin_date")
  status            CheckinStatus
  loggedDays        Int           @map("logged_days")
  previousKcal      Int           @map("previous_kcal")
  /// null for skipped weeks. For "kept" weeks: what was offered.
  newKcal           Int?          @map("new_kcal")
  proteinG          Int?          @map("protein_g")
  carbsG            Int?          @map("carbs_g")
  fatG              Int?          @map("fat_g")
  avgIntakeKcal     Float?        @map("avg_intake_kcal")
  estimatedBurnKcal Float?        @map("estimated_burn_kcal")
  trendStartKg      Float?        @map("trend_start_kg")
  trendEndKg        Float?        @map("trend_end_kg")
  capped            Boolean       @default(false)
  /// D87: the week's report card (shared/domain/report.ts), made on the phone when the check-in is answered.
  report            Json?
  clientUpdatedAt   DateTime      @map("client_updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, checkinDate])
  @@map("checkins")
}

// ---------------------------------------------------------------------------
// P29 · Phases as projects (D51). One active phase per user (closed_at IS NULL), enforced on the phone. Logs
// belong to whichever phase covered their date. kcal / protein_g null = follow the plan from the profile.
// summary is frozen when the phase is closed (shared/domain/progress.ts PhaseSummary).

model Phase {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String
  goal            Goal
  startDate       String    @map("start_date")
  /// Planned end; null = open-ended.
  endDate         String?   @map("end_date")
  targetWeightKg  Float?    @map("target_weight_kg")
  kcal            Int?
  proteinG        Int?      @map("protein_g")
  /// The local day the phase was closed; null while active.
  closedDate      String?   @map("closed_date")
  summary         Json?
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("phases")
}

// ---------------------------------------------------------------------------
// LA1–LA5 · Life plan (docs/LIFE_PLAN.md, D72–D80). Standing life lives on the profile; the brief, the accepted plan
// and the memory facts are local-first entities synced like the rest (D23). Chat transcripts never come here (D78).
// `LifeMealSource` is the plan's "MealSource" (renamed: MealSource already means how a meal was logged).
// ---------------------------------------------------------------------------

enum LifeMealSource {
  home_self
  home_family
  mess
  canteen
  eat_out
  mixed
}

enum BudgetBand {
  comfortable
  careful
  tight
}

enum WorkPattern {
  office
  shifts
  student
  wfh
  irregular
}

enum BriefStatus {
  draft
  confirmed
}

/// calendar is unused until later (D74).
enum BriefSource {
  brief
  calendar
  inferred
}

model DayBrief {
  id              String      @id @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  /// The day it describes.
  localDate       String      @map("local_date")
  /// What the user said; editable.
  rawText         String      @map("raw_text")
  /// DayFacts (shared/domain/life.ts), already validated.
  parsed          Json
  status          BriefStatus
  source          BriefSource
  clientUpdatedAt DateTime    @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, localDate])
  @@map("day_briefs")
}

model DayPlan {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  localDate       String    @map("local_date")
  /// DayPlan (shared/domain/planDay.ts).
  plan            Json
  /// Re-plan only when the inputs change (planInputsHash).
  inputsHash      String    @map("inputs_hash")
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  clientUpdatedAt DateTime  @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, localDate])
  @@map("day_plans")
}

enum FactKind {
  constraint
  pattern
  preference
  event
}

enum FactSource {
  onboarding
  brief
  chat
  inferred
  user
}

enum FactStatus {
  suggested
  active
  dismissed
}

model MemoryFact {
  id              String     @id @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  /// Stable, e.g. "usual_meal:lunch:weekday" (shared/domain/memory.ts FACT_KEYS). One row per key on the phone.
  key             String
  kind            FactKind
  value           Json
  text            String
  source          FactSource
  /// 0–1, inferred facts only.
  confidence      Float
  /// { count, window, lastSeen }
  evidence        Json?
  status          FactStatus
  validFrom       String?    @map("valid_from")
  validUntil      String?    @map("valid_until")
  clientUpdatedAt DateTime   @map("client_updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, key])
  @@map("memory_facts")
}
