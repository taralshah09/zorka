{
  "name": "zorka-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/backend/src/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "eval:assistant": "tsx --env-file-if-exists=.env scripts/assistant-eval.ts",
    "db:seed": "prisma db seed",
    "db:seed:arjun": "tsx --env-file-if-exists=.env prisma/seed-demo-arjun.ts --write",
    "db:seed:arjun:dry": "tsx --env-file-if-exists=.env prisma/seed-demo-arjun.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo-personas.ts --write",
    "db:seed:demo:dry": "tsx --env-file-if-exists=.env prisma/seed-demo-personas.ts",
    "loadtest:db:up": "docker compose -f loadtest/docker-compose.yml up -d --wait",
    "loadtest:db:down": "docker compose -f loadtest/docker-compose.yml down -v",
    "loadtest:smoke": "k6 run -e PROFILE=smoke loadtest/k6.js",
    "loadtest:load": "k6 run -e PROFILE=load --out web-dashboard=export=loadtest/reports/load.html --summary-export=loadtest/reports/load.json loadtest/k6.js",
    "loadtest:stress": "k6 run -e PROFILE=stress --out web-dashboard=export=loadtest/reports/stress.html --summary-export=loadtest/reports/stress.json loadtest/k6.js",
    "loadtest:spike": "k6 run -e PROFILE=spike --out web-dashboard=export=loadtest/reports/spike.html --summary-export=loadtest/reports/spike.json loadtest/k6.js",
    "loadtest:soak": "k6 run -e PROFILE=soak --out web-dashboard=export=loadtest/reports/soak.html --summary-export=loadtest/reports/soak.json loadtest/k6.js",
    "loadtest:constrained": "k6 run -e PROFILE=constrained --out web-dashboard=export=loadtest/reports/constrained.html --summary-export=loadtest/reports/constrained.json loadtest/k6.js",
    "loadtest:render": "k6 run -e PROFILE=render --out web-dashboard=export=loadtest/reports/render.html --summary-export=loadtest/reports/render.json loadtest/k6.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.7",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
