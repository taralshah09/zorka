{
  "name": "zorka-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/backend/src/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:arjun": "tsx --env-file-if-exists=.env prisma/seed-demo-arjun.ts --write",
    "db:seed:arjun:dry": "tsx --env-file-if-exists=.env prisma/seed-demo-arjun.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env prisma/seed-demo-personas.ts --write",
    "db:seed:demo:dry": "tsx --env-file-if-exists=.env prisma/seed-demo-personas.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.7",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
